# Copy to .env and fill in. .env is gitignored and must be chmod 600 on the VPS.
#
# PS_SOURCE_URI   - the Serverpod database PowerSync replicates FROM.
#                   Uses powersync_role, which is REPLICATION + read-only.
# PS_STORAGE_URI  - PowerSync's own bucket storage. A SEPARATE database that you
#                   must create by hand once:
#                     CREATE DATABASE powersync_storage WITH OWNER = powersync_role;
# PS_JWK_*        - public half of the keypair from tool/generate_keys.dart.

PS_SOURCE_URI=postgresql://powersync_role:CHANGE_ME@postgres:5432/book_marker
PS_STORAGE_URI=postgresql://powersync_role:CHANGE_ME@postgres:5432/powersync_storage

PS_JWK_N=
PS_JWK_E=AQAB
PS_JWK_KID=
