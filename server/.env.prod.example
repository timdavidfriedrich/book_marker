# Copy to `.env` ON THE VPS (server/.env) and fill in. Never committed.
#   chmod 600 .env
#
# Note this is the PRODUCTION env file and lives at server/.env, beside
# docker-compose.prod.yaml. The local development one is a different file at
# server/book_marker_server/.env.

# --- Postgres / Redis -------------------------------------------------------
# POSTGRES_PASSWORD must match `database:` in book_marker_server/config/passwords.yaml
# REDIS_PASSWORD    must match `redis:`    in the same file.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- PowerSync --------------------------------------------------------------
# powersync_role is created by powersync/setup_replication.sql. Host is the
# compose service name, not localhost.
PS_SOURCE_URI=postgresql://powersync_role:CHANGE_ME@postgres:5432/book_marker
PS_STORAGE_URI=postgresql://powersync_role:CHANGE_ME@postgres:5432/powersync_storage

# Public half of the keypair from `dart run tool/generate_keys.dart`.
# The private half goes in passwords.yaml, never here.
PS_JWK_N=
PS_JWK_E=AQAB
PS_JWK_KID=

# --- MinIO ------------------------------------------------------------------
# The root credentials for the object store. Create a separate, restricted
# access key for the server itself and put THAT in passwords.yaml as
# minioAccessKey / minioSecretKey; the root pair should not be what the app uses.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
